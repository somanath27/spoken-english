erDiagram
    %% ========================================
    %% USER & AUTHENTICATION
    %% ========================================
    
    users ||--o| user_profiles : "has profile"
    users ||--o{ streaks : "tracks daily"
    users ||--o{ reminders : "configures"
    users ||--o{ module_progress : "tracks modules"
    users ||--o{ lesson_progress : "tracks lessons"
    users ||--o{ section_progress : "tracks sections"
    users ||--o{ quiz_attempts : "attempts quizzes"
    users ||--o{ practice_sessions : "practices"
    users ||--o{ audio_recordings : "records"
    users ||--o{ flashcard_reviews : "reviews"
    
    users {
        ObjectId _id PK
        string phone UK "unique, required"
        string email UK "optional, unique"
        string passwordHash "required"
        string role "default: learner"
        datetime createdAt
        datetime updatedAt
    }
    
    user_profiles {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        string name "required"
        string nativeLanguage "e.g., Spanish, Hindi"
        string level "beginner|intermediate|advanced"
        array learningGoals "array of strings"
        int totalPoints "default: 0"
        int currentStreak "default: 0"
        int longestStreak "default: 0"
        date lastActiveDate
        string preferredTheme "light|dark"
        string appLanguage "en|hi|id|es|ar"
        datetime createdAt
        datetime updatedAt
    }
    
    streaks {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        int currentStreak "default: 0"
        int longestStreak "default: 0"
        date lastCompletedDate
        int dailyGoalMinutes "default: 15"
        boolean goalMetToday "default: false"
        datetime createdAt
        datetime updatedAt
    }
    
    reminders {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        string time "HH:MM format"
        array daysOfWeek "0-6, 0=Sunday"
        boolean isEnabled "default: true"
        string message "reminder text"
        datetime createdAt
        datetime updatedAt
    }
    
    %% ========================================
    %% LEARNING CONTENT HIERARCHY
    %% ========================================
    
    modules ||--o{ lessons : "contains"
    modules ||--o{ module_progress : "tracked by"
    modules ||--o{ flashcard_decks : "has decks"
    
    lessons ||--o{ sections : "contains"
    lessons ||--o{ lesson_progress : "tracked by"
    lessons ||--o{ questions : "has questions"
    
    sections ||--o{ section_progress : "tracked by"
    
    modules {
        ObjectId _id PK
        string title "required"
        string description
        string difficulty "beginner|intermediate|advanced"
        string category "e.g., Business, Travel"
        string thumbnailUrl
        int sequenceNumber "display order"
        boolean isPublished "default: false"
        int estimatedDurationMins
        array topics "array of strings"
        datetime createdAt
        datetime updatedAt
    }
    
    lessons {
        ObjectId _id PK
        ObjectId moduleId FK "ref: modules"
        string title "required"
        string description
        string shortDescription "for cards"
        string level "beginner|intermediate|advanced"
        string category
        string thumbnailUrl
        int sequenceNumber "within module"
        int estimatedDurationMins
        boolean isPublished "default: false"
        array topics "array of strings"
        array vocabulary "word, definition, pronunciation"
        datetime createdAt
        datetime updatedAt
    }
    
    sections {
        ObjectId _id PK
        ObjectId lessonId FK "ref: lessons"
        string type "video|audio|quiz|flashcards|practice"
        string title "required"
        string content "text or instructions"
        string videoUrl "for video type"
        string audioUrl "for audio type"
        object transcript "time-synced text"
        int sequenceNumber "order within lesson"
        int estimatedDurationMins
        boolean isRequired "default: true"
        datetime createdAt
        datetime updatedAt
    }
    
    %% ========================================
    %% QUESTION BANK & PRACTICE
    %% ========================================
    
    questions ||--o{ practice_session_questions : "used in"
    questions ||--o{ question_attempts : "attempted"
    
    practice_sessions ||--o{ practice_session_questions : "contains"
    practice_sessions ||--o{ question_attempts : "records"
    
    questions {
        ObjectId _id PK
        ObjectId lessonId FK "ref: lessons, nullable"
        ObjectId moduleId FK "ref: modules, nullable"
        string type "mcq|multi_select|fill_blanks|match|arrange|pronunciation|speaking"
        string difficulty "easy|medium|hard"
        string level "beginner|intermediate|advanced"
        string questionText "required"
        string instruction "optional guidance"
        string audioUrl "for pronunciation/speaking"
        string phonetic "for pronunciation"
        array options "for mcq, multi_select, fill_blanks word bank"
        mixed correctAnswer "index|array|object based on type"
        object matchPairs "for match type: [{left, right}]"
        array correctOrder "for arrange type: indices"
        string explanation "why answer is correct"
        string translationContext "for speaking questions"
        array tags "grammar, vocabulary, past_tense, etc"
        int pointsValue "default: 10"
        boolean isPublished "default: true"
        int usageCount "times used in practice"
        float averageAccuracy "0-100"
        datetime createdAt
        datetime updatedAt
    }
    
    practice_sessions {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        ObjectId lessonId FK "ref: lessons, nullable"
        ObjectId moduleId FK "ref: modules, nullable"
        string sessionType "mcq|pronunciation|speaking|mixed"
        string status "in_progress|completed|abandoned"
        int totalQuestions
        int questionsAnswered
        int correctAnswers
        int totalPoints
        float accuracyPercentage "0-100"
        datetime startedAt
        datetime completedAt
        int durationSeconds
        datetime createdAt
        datetime updatedAt
    }
    
    practice_session_questions {
        ObjectId _id PK
        ObjectId sessionId FK "ref: practice_sessions"
        ObjectId questionId FK "ref: questions"
        int sequenceNumber "order in session"
        datetime createdAt
    }
    
    question_attempts {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        ObjectId sessionId FK "ref: practice_sessions"
        ObjectId questionId FK "ref: questions"
        mixed userAnswer "format depends on question type"
        boolean isCorrect
        float accuracyScore "0-100, for pronunciation/speaking"
        string recognizedText "for voice questions"
        int pointsEarned
        int attemptNumber "1st, 2nd try, etc"
        datetime attemptedAt
    }
    
    %% ========================================
    %% QUIZ & ASSESSMENT (Legacy from Schema)
    %% ========================================
    
    quiz_attempts {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        ObjectId lessonId FK "ref: lessons, nullable"
        ObjectId sectionId FK "ref: sections, nullable"
        string quizType "lesson_quiz|practice_quiz"
        int score
        int totalQuestions
        float percentage
        object answers "question-answer pairs"
        datetime attemptedAt
        datetime createdAt
    }
    
    %% ========================================
    %% FLASHCARDS
    %% ========================================
    
    flashcard_decks ||--o{ flashcards : "contains"
    flashcards ||--o{ flashcard_reviews : "reviewed"
    
    flashcard_decks {
        ObjectId _id PK
        ObjectId moduleId FK "ref: modules, nullable"
        ObjectId lessonId FK "ref: lessons, nullable"
        string title "required"
        string description
        int cardCount
        string difficulty "beginner|intermediate|advanced"
        boolean isPublished "default: true"
        datetime createdAt
        datetime updatedAt
    }
    
    flashcards {
        ObjectId _id PK
        ObjectId deckId FK "ref: flashcard_decks"
        string frontText "word or question"
        string backText "meaning or answer"
        string frontAudioUrl "optional pronunciation"
        string backAudioUrl
        string exampleSentence
        string difficulty "easy|medium|hard"
        int sequenceNumber
        array tags
        datetime createdAt
        datetime updatedAt
    }
    
    flashcard_reviews {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        ObjectId cardId FK "ref: flashcards"
        int easeFactor "SM-2 algorithm: 1.3-2.5"
        int interval "days until next review"
        int repetitions "successful reviews"
        date nextReviewAt "next scheduled date"
        string lastReviewQuality "again|hard|good|easy"
        datetime lastReviewedAt
        datetime createdAt
        datetime updatedAt
    }
    
    %% ========================================
    %% PROGRESS TRACKING
    %% ========================================
    
    module_progress {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        ObjectId moduleId FK "ref: modules"
        string status "not_started|in_progress|completed"
        int percentComplete "0-100"
        int completedLessons
        int totalLessons
        datetime startedAt
        datetime completedAt
        datetime lastAccessedAt
        datetime createdAt
        datetime updatedAt
    }
    
    lesson_progress {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        ObjectId lessonId FK "ref: lessons"
        string status "not_started|in_progress|completed"
        int percentComplete "0-100"
        int videoWatchedSeconds "playback position"
        int videoDurationSeconds
        boolean videoCompleted
        int completedSections
        int totalSections
        string lastSection "last accessed section type"
        datetime startedAt
        datetime completedAt
        datetime lastAccessedAt
        datetime createdAt
        datetime updatedAt
    }
    
    section_progress {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        ObjectId lessonId FK "ref: lessons"
        ObjectId sectionId FK "ref: sections"
        boolean isCompleted "default: false"
        int timeSpentSeconds
        datetime completedAt
        datetime lastAccessedAt
        datetime createdAt
        datetime updatedAt
    }
    
    %% ========================================
    %% AUDIO RECORDINGS (Voice Practice)
    %% ========================================
    
    audio_recordings {
        ObjectId _id PK
        ObjectId userId FK "ref: users"
        ObjectId questionId FK "ref: questions, nullable"
        ObjectId lessonId FK "ref: lessons, nullable"
        string recordingUrl "S3 or CDN URL"
        string transcription "recognized text"
        float accuracyScore "0-100"
        string targetText "what user should say"
        int durationSeconds
        string recordingType "pronunciation|speaking"
        datetime recordedAt
        datetime createdAt
    }
